<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        android.widget.NumberPicker 전용 테마.
        휠 프리뷰 Paint는 생성 시 EditText의 textColorPrimary를 복사하므로,
        Material Light 기반으로 고정 검정(#171719)을 넣는다.
        NumberPicker는 시스템 뷰라 Compose 다크 모드를 따라가면 흰 글씨가 되어
        밝은 시트 배경에서 안 보인다 — 라이트 고정.
    -->
    <style name="LiroutiNumberPicker" parent="@android:style/Theme.Material.Light">
        <item name="android:textColorPrimary">#171719</item>
        <item name="android:textColorSecondary">#171719</item>
        <item name="android:textColor">#171719</item>
        <item name="android:colorForeground">#171719</item>
    </style>
</resources>
