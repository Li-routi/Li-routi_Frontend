<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        android.widget.NumberPicker 전용 스타일. NumberPicker는 가운데 선택 값(EditText) 바깥의
        휠 프리뷰 값들을 내부 Paint(mSelectorWheelPaint)로 그리는데, 이 Paint의 초기 색상은 생성
        시점에 EditText의 기본 텍스트 색(테마의 android:textColorPrimary)에서 복사된다.
        [WheelNumberPicker]가 이 스타일로 감싼 Context로 NumberPicker를 생성해, 리플렉션 없이도
        휠 프리뷰 값이 옅은 회색이 아니라 앱 라벨 색(labelDefault, Neutral10)으로 나오게 한다.
        NumberPicker는 안드로이드 뷰라 Compose 테마(다크 모드 등)를 못 따라가므로 라이트 고정 색이다.
    -->
    <style name="LiroutiNumberPicker" parent="android:Widget">
        <item name="android:textColorPrimary">#171719</item>
        <item name="android:textColor">#171719</item>
    </style>
</resources>
